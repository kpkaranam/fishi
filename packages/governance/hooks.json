{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "command": "node scripts/session-init.mjs"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "command": "node scripts/safety-check.mjs"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "command": "node scripts/audit-logger.mjs"
      }
    ]
  }
}
